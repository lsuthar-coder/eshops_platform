PORT=4100
NODE_ENV=development

ALLOWED_ORIGINS=https://admin.lsuthar.in

MONGO_URI=mongodb://username:password@localhost:27017/eshops
REDIS_URL=redis://localhost:6379
POSTGRES_URL=postgresql://username:password@localhost:5432/eshops

JWT_SECRET=change-me-to-a-long-random-value

# 32-byte key, hex-encoded (64 hex chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Same wildcard base domain as Portal/Store API.
PLATFORM_DOMAIN=eshops.lsuthar.in

# Static IP of your ingress load balancer — shown to admins as the
# A-record target when they add a custom domain.
PLATFORM_INGRESS_IP=203.0.113.10

# Jenkins — custom domain Ingress + Certificate provisioning only.
# (Not used for store creation anymore — see portal_backend's README.)
JENKINS_URL=https://jenkins.example.com
JENKINS_USER=jenkins-backend-trigger
JENKINS_API_TOKEN=your-api-token
JENKINS_DOMAIN_JOB=eshops-provision-domain
JENKINS_WEBHOOK_SECRET=change-me-to-a-long-random-value

# Resend — 7-day domain verification alert emails, from updates@lsuthar.in
RESEND_API_KEY=your-resend-api-key

# Optional — only used for logging/reference, not required at startup
ADMIN_PORTAL_URL=https://admin.lsuthar.in

# Namespace to look for cert-manager Certificate resources in
# (used by jobs/certificateReadinessJob.js)
K8S_NAMESPACE=default

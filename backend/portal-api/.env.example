PORT=3000
NODE_ENV=development

# Comma-separated list of allowed origins for CORS (no wildcard in production)
ALLOWED_ORIGINS=http://localhost:5173

# Base domain for tenant stores: https://<tenant_id>.<PLATFORM_DOMAIN>
# The wildcard Ingress/cert cover *.eshops.lsuthar.in, so this should be
# "eshops.lsuthar.in" — no per-tenant Kubernetes object is created.
PLATFORM_DOMAIN=eshops.lsuthar.in

# PostgreSQL — tenant + admin credential records (sensitive data lives here)
POSTGRES_URL=postgresql://username:password@localhost:5432/eshops

# MongoDB — store config object
MONGO_URI=mongodb://username:password@localhost:27017/eshops

# Redis — fast-read config cache, dual-keyed by domain and tenant uuid
REDIS_URL=redis://localhost:6379

# bcrypt cost factor
BCRYPT_ROUNDS=12

# Resend — OTP verification emails, sent from updates@lsuthar.in
RESEND_API_KEY=your-resend-api-key

# Fixed URL every store admin logs into (tenant resolved from their JWT
# after login, not from the hostname) — placeholder until Admin Portal
# app exists. Same for every tenant.
ADMIN_PORTAL_URL=https://admin.lsuthar.in

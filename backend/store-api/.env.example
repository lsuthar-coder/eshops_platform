PORT=4000
NODE_ENV=development

# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:5174

# MongoDB — store config, products, categories, orders, reviews, users
MONGO_URI=mongodb://username:password@localhost:27017/eshops

# Redis — fast-read config cache (dual-keyed by domain and tenant uuid,
# written by Portal on tenant creation)
REDIS_URL=redis://localhost:6379

# Must match the secret used to sign customer JWTs at login
JWT_SECRET=change-me-to-a-long-random-value

# Base domain for the always-on generated URL: https://<tenantId>.<PLATFORM_DOMAIN>
PLATFORM_DOMAIN=eshops.lsuthar.in

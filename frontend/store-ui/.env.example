# Leave empty in production — Store API must be same-origin (see the
# deployment note in store-api's resolveTenant.js). Only set this for
# local dev if Store API runs on a different port than this app.
VITE_API_BASE_URL=

# Dev-only: which tenant to load locally, since there's no real
# subdomain routing on localhost. Ignored by Store API in production.
VITE_DEV_TENANT_HOST=abc123.eshops.lsuthar.in

# Fixed admin login URL, shown as "Manage this store" in the footer.
VITE_ADMIN_PORTAL_URL=https://admin.lsuthar.in

# Shown on the "Store not found" screen as a "Create your own store" link.
VITE_PORTAL_URL=https://portal.lsuthar.in
